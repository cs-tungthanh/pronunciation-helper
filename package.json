{
  "name": "sayly",
  "version": "1.2.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "vite build --watch --mode development & vite build -c vite.config.content.ts --watch --mode development",
    "dev:edge": "bash scripts/dev-edge.sh",
    "build": "tsc && vite build && vite build -c vite.config.content.ts",
    "build:zip": "pnpm run build && cd dist && zip -r ../sayly.zip .",
    "type-check": "tsc --noEmit",
    "cmudict": "node scripts/build-cmudict.js",
    "cws:check": "node scripts/get-refresh-token.js check",
    "cws:token": "node scripts/get-refresh-token.js",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "web-ext": "^10.8.0"
  },
  "dependencies": {
    "lucide": "^1.61.0"
  }
}
